# ==============================================================================
# CimaTex - Variables de Entorno de Producción (.env.example)
# Servidor VPS Hostinger - CodeCima
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Puertos del Servidor Host (VPS)
# ------------------------------------------------------------------------------
# Puerto expuesto en el VPS para acceder a la aplicación web (CimaTex Frontend)
WEB_PORT=8080

# Puerto expuesto en localhost para la API de CimaTex
API_PORT=4000

# Puerto local para la base de datos PostgreSQL de CimaTex (evita colisiones con Cimafact)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL 16 (cimatex_postgres)
# ------------------------------------------------------------------------------
POSTGRES_DB=cimatex_db
POSTGRES_USER=cimatex_user
POSTGRES_PASSWORD=cimatex_secure_pass_cambiar_en_produccion

# ------------------------------------------------------------------------------
# 3. Autenticación y Seguridad (cimatex_api)
# ------------------------------------------------------------------------------
# Secreto para firmar tokens JWT (generar con: openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_cimatex_production_32chars_random

# Tiempo de expiración de los tokens de sesión JWT
JWT_EXPIRES_IN=30d

# ID de Cliente de Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Orígenes CORS autorizados (separados por coma, o '*' para permitir todo)
CORS_ORIGIN=https://cimatex.codecima.com,http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Parámetros del Frontend Web (Vite)
# ------------------------------------------------------------------------------
# URL base de la API (en desarrollo: http://localhost:4000, en producción con proxy Nginx: /api o vacío)
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
