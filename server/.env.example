# ==============================================================================
# CimaTex API - Variables de Entorno (.env.example)
# Servidor VPS Hostinger - CodeCima
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Conexión a Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# Cuando se ejecuta dentro de docker-compose, el host es el nombre del servicio 'cimatex_postgres'
DB_HOST=cimatex_postgres
DB_PORT=5432
DB_USER=cimatex_user
DB_PASSWORD=cimatex_secure_password_here
DB_NAME=cimatex_db
DB_POOL_MAX=20

# Alternativa: URI de conexión directa (anula DB_HOST/USER/etc si está definido)
# DATABASE_URL=postgres://cimatex_user:cimatex_secure_password_here@cimatex_postgres:5432/cimatex_db

# SSL (true/false) - Usar 'true' si se conecta a un PostgreSQL gestionado externamente
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# Autenticación y Seguridad
# ------------------------------------------------------------------------------
# Secreto para firmar tokens JWT (generar con: openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_cimatex_change_in_production_32chars
JWT_EXPIRES_IN=30d

# Google OAuth 2.0 Client ID (obtenido de Google Cloud Console -> Credenciales)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Orígenes permitidos para CORS (separados por coma, o '*' para todos)
CORS_ORIGIN=https://cimatex.codecima.com,http://localhost:8080,http://localhost:5173
